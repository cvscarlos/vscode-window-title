#!/bin/sh
# Full gate before anything leaves the machine: clean, compile, lint, format
# check, then the Mocha suite in a real VS Code instance.
set -e

if [ ! -d node_modules ]; then
	echo "pre-push: node_modules missing, skipping tests (run npm install)"
	exit 0
fi

echo "pre-push: running the full test suite…"
npm test

echo "pre-push: ok"
