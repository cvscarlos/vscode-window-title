# Secrets & internal (never ship)
.env
.claude/**
.fallow/**
.superpowers/**

# Source & build tooling (only dist/ ships; out/ is the unbundled build the tests run against)
src/**
out/**
**/*.ts
**/*.map
**/tsconfig.json
**/eslint.config.mjs
.prettierrc.json
.prettierignore
.nvmrc

# Editor / test / dev dirs
.vscode/**
.vscode-test/**
**/.vscode-test.*
tmp/**

# Repo metadata
.gitignore
.github/**
docs/**
ARCHITECTURE.md

# Icon source + the social banner (used by the repo, not by the extension;
# only images/icon.png needs to ship)
images/*.svg
images/og-banner.png

# Git hooks (dev only)
.githooks/**
